<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\SeamFinder.Core\SeamFinder.Core.csproj" />
  </ItemGroup>

  <!-- Bundled alongside the exe so collision-awareness works standalone on
       any machine this is downloaded to - CollisionRaycaster resolves this
       relative to AppContext.BaseDirectory, never a hardcoded dev path. -->
  <ItemGroup>
    <Content Include="..\collision-raycast\extract_collision.py">
      <Link>collision-raycast\extract_collision.py</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Trimmed PyNifly (NiflyDLL.dll + its pyn/ Python wrapper only - not the
       full ~43MB Blender addon) so real collision-awareness works out of the
       box with no manual setup - previously required the user to download
       PyNifly separately and place it by hand. GPL-3.0; see
       pynifly\NOTICE.md for why this is fine alongside this tool's own MIT
       license (PyNifly runs as its own separate process, never linked into
       this binary - "mere aggregation" under GPL's own FAQ). -->
  <ItemGroup>
    <None Include="..\pynifly\**" CopyToOutputDirectory="PreserveNewest" LinkBase="pynifly" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Version>2.0.3</Version>
    <AssemblyVersion>2.0.3.0</AssemblyVersion>
    <FileVersion>2.0.3.0</FileVersion>
  </PropertyGroup>

</Project>
